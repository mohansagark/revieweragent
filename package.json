{
  "name": "revieweragent",
  "version": "1.0.0",
  "description": "Wire automatic AI pull-request review into a git repo.",
  "type": "module",
  "bin": {
    "revieweragent": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "actions/review/action.yml",
    "actions/review/dist",
    "pinned-shas.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/mohansagark/revieweragent",
  "bugs": {
    "url": "https://github.com/mohansagark/revieweragent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.json",
    "build:action": "node esbuild.action.mjs",
    "build": "npm run build:cli && npm run build:action",
    "prepublishOnly": "npm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"actions/**/*.ts\" \"tests/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohansagark/revieweragent.git"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@octokit/rest": "^21.0.2",
    "commander": "^12.1.0",
    "libsodium-wrappers": "^0.7.15",
    "minimatch": "^10.0.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
